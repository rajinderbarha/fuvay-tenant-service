{
  "expo": {
    "name": "ServiceOS",
    "slug": "serviceos-customer",
    "version": "1.0.0",
    "scheme": "serviceos",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.serviceos.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ServiceOS needs your location to find services near you and track your technician."
      }
    },
    "android": {
      "package": "com.serviceos.customer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-notifications",
      "expo-image-picker",
      "expo-secure-store",
      "expo-localization",
      "expo-font"
    ],
    "sdkVersion": "54.0.0"
  }
}
