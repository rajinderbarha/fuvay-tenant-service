# ServiceOS Customer App — Environment Variables
# Copy to .env before running with Expo

# ── Backend connection ──────────────────────────────────────────────────────
# Simulator / Emulator (same machine as backend):
EXPO_PUBLIC_API_URL=http://localhost:8000

# Physical device (replace with your computer's local IP address):
# Find it with: ipconfig (Windows) | ifconfig (Mac/Linux) | ip addr (Linux)
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# Staging / Production:
# EXPO_PUBLIC_API_URL=https://api.serviceos.in

# Note: DeepSeek API key is NOT set here.
# It lives only in the backend .env as DEEPSEEK_API_KEY.
# The customer app never touches the key directly.

# ── App environment (CUSTOMER-L5-00) ────────────────────────────────────────
# One of: local | development | test | staging | production
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_API_TIMEOUT_MS=15000
EXPO_PUBLIC_BUILD_VERSION=0.0.0-dev
EXPO_PUBLIC_BUILD_NUMBER=0
EXPO_PUBLIC_ANALYTICS_ENABLED=false
EXPO_PUBLIC_CRASH_REPORTING_ENABLED=false
EXPO_PUBLIC_LOG_LEVEL=debug
# Mock mode is ignored outside local/development/test builds.
EXPO_PUBLIC_MOCK_MODE=false
EXPO_PUBLIC_DEEP_LINK_SCHEME=serviceos
