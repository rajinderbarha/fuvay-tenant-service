    "@react-navigation/native": "^7.0.18",
    "@react-navigation/native-stack": "^7.2.1",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~54.0.37",
    "expo-clipboard": "~8.0.7",
    "expo-crypto": "~15.0.7",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.8",
