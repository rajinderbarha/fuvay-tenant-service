# Fuvay — Environment Variables Reference
# Copy to .env and fill in values.
# NEVER commit .env (with real secrets) to git.
# Key names here MUST match app/config.py exactly.

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
APP_VERSION=rc-1
DEBUG=false                               # Set to true ONLY in development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-64-char-random-hex-string

# ── API ───────────────────────────────────────────────────────────────────────
# Comma-separated list. No trailing slash. No wildcard in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Only these proxy networks may supply X-Forwarded-For/CF-Connecting-IP.
# Replace with your Cloudflare/load-balancer CIDRs in production.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TURNSTILE_REQUIRED=false
SIGNUP_DEV_OTP_ENABLED=false              # Show signup test codes in dev/staging only; never production
MESSAGING_DEV_OTP_ENABLED=false           # Show Instagram phone-link test code in dev/staging only
MESSAGING_DEV_PHONE_BYPASS_ENABLED=false  # Explicit temporary Instagram bypass; keep false on domain deployments
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
OTP_DAILY_GLOBAL_LIMIT=1000
OTP_DAILY_RECIPIENT_LIMIT=5
OTP_DAILY_IP_LIMIT=20
OTP_DAILY_SOURCE_LIMIT=20
BOOKING_MAX_ACTIVE_DRAFTS=3
BOOKING_MAX_CONFIRMATIONS_PER_DAY=5

# ── Database ─────────────────────────────────────────────────────────────────
# asyncpg driver for the FastAPI app
DATABASE_URL=postgresql+asyncpg://serviceos:serviceos@localhost:5432/serviceos
# Per-process pool. Total potential connections are
# replicas * API workers * (pool size + max overflow).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=30
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=60
# Used by docker-compose postgres service only (not by config.py)
POSTGRES_USER=serviceos
POSTGRES_PASSWORD=serviceos
POSTGRES_DB=serviceos

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
# For production with password: redis://:yourpassword@host:6379/0
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-64-char-random-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# DeepSeek API key (required for AI conversation features)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# OpenAI API key (optional — for RAG engine embeddings)
OPENAI_API_KEY=

# ── Storage — Cloudinary (primary media storage) ──────────────────────────────
# Required for provider document uploads, complaint evidence, review media.
# Leave blank to disable upload features gracefully (uploads return 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Leave blank to auto-select Cloudinary whenever the credentials above exist.
# Set explicitly to cloudinary in deployed environments.
FILE_STORAGE_DRIVER=
# Optional temporary override for accounts where Cloudinary raw/document
# delivery is disabled. Leave blank when Cloudinary accepts document uploads.
# Instagram warranty PDFs use this driver after the completion rating request.
# Documents must be downloadable by Meta over public HTTPS as application/pdf.
# For local storage, set FILE_STORAGE_PUBLIC_BASE_URL to the public HTTPS API
# origin; a localhost or relative URL cannot be fetched by Instagram.
FILE_STORAGE_DOCUMENT_DRIVER=

# FILE_STORAGE_DRIVER=local (dev-only override): required if you set this,
# otherwise every locally-stored asset's public_url is a bare "/uploads/..."
# path that only resolves for a caller sharing this API's own origin --
# every OTHER app (super-admin's Next.js dev server, the mobile apps) 404s
# on it. Cloudinary/S3 don't need this; they always return an absolute URL.
FILE_STORAGE_PUBLIC_BASE_URL=http://localhost:8000

# ── Storage — AWS S3 (optional fallback) ──────────────────────────────────────
AWS_S3_BUCKET=serviceos-media
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Notifications ─────────────────────────────────────────────────────────────
# All notification providers are optional — missing keys disable that channel safely.
FCM_SERVER_KEY=               # Firebase push notifications
TWILIO_ACCOUNT_SID=           # SMS OTP
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=             # Transactional email

# ── Email (SMTP fallback) ──────────────────────────────────────────────────────
EMAIL_USERNAME=
EMAIL_PASSWORD=               # App password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

# ── Observability ─────────────────────────────────────────────────────────────
SENTRY_DSN=                   # Leave empty to disable Sentry
SENTRY_TRACES_RATE=0.1
SENTRY_PROFILES_RATE=0.05
ENABLE_METRICS=true           # Prometheus /metrics endpoint

# ── Production docker-compose extras ─────────────────────────────────────────
# These are used by docker-compose.prod.yml only, not by config.py.
GRAFANA_PASSWORD=change-me
IMAGE_TAG=rc-1

# ── Frontend (Next.js build-time env — set in CI/CD for each environment) ────
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com
# NEXT_PUBLIC_USE_MOCK=false   # NEVER set to true in production

# Customer web surface origin — required for chat -> web booking handoff links.
# Empty means no handoff link is ever sent.
