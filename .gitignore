# Dependencies
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# Build output
.next/
dist/
build/
# Anchored: a bare `coverage/` matches ANY directory of that name, including
# source such as frontend/tenant-portal/components/coverage/, which it silently
# kept out of git entirely.
/coverage/
frontend/*/coverage/
mobile/*/coverage/
*.tsbuildinfo

# Environment / secrets
.env
.env.local
.env.*.local
.env.production

# Logs
*.log

# Playwright / test artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
artifacts/
frontend/e2e-admin-tenant/evidence/
var/audits/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
.codex-logs/
.runlogs/
.expo/

# Uploads (runtime data, not source)
uploads/

# Private export files (runtime data, not source — FINAL-L5-05S)
var/exports/
var/*.log
var/*.png

# Local database backups (may contain data, never commit)
.backups/

# Bundled local PostgreSQL install + live data + installers (not source, huge, regenerable)
db/pgsql/
db/pgdata/
db/pgvector.zip
db/pgvector_extract/
db/postgresql-16-fresh.zip
db/*.tmp
db/*.log.txt
db/pg_log.txt
db/pglog.txt
frontend/super-admin/tsconfig.tsbuildinfo

# Editor/shell temp artifacts (never source)
*.stackdump
*.tmp.*
frontend/customer-app/tsconfig.tsbuildinfo

# Browser-only customer portal was retired; customer and staff experiences are native apps.
frontend/customer-web/
backup_job_data_before_purge.sql
db/backup_*.sql

# Browser profile / scratch output from local reference captures (190MB+).
.artifacts/
